{
  "name": "wa-catalog",
  "type": "module",
  "version": "1.0.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "evennode": "npx http-server ./dist",
    "dev": "pnpm --filter front dev",
    "dev:front": "pnpm --filter front dev",
    "dev:bot": "pnpm --filter bot dev",
    "build": "pnpm -r build",
    "build:front": "pnpm --filter front build",
    "build:bot": "pnpm --filter bot build",
    "preview": "pnpm --filter front astro preview",
    "astro": "pnpm --filter front astro",
    "format": "pnpm -r format"
  }
}
