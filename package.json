{
  "name": "wa-catalog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "repo-sync -f products.config.cjs && astro build",
    "preview": "pnpm run build && wrangler dev",
