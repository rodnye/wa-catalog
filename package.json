    "format": "prettier --write .",
    "generate-types": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.4",
    "@astrojs/preact": "^5.1.3",
    "@astrojs/tailwind": "^6.0.2",
    "@nanostores/preact": "^1.1.0",
    "@rodny/repo-sync": "^1.3.0",
    "astro": "^6.3.6",
    "nanostores": "^1.3.0",
    "preact": "^10.29.2",
    "tailwindcss": "^3.4.19",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "wrangler": "^4.94.0"
  },
  "overrides": {
    "vite": "^7"
  }
