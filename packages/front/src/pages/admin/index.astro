---
const redirectTo = '/admin/v2';
---

<!doctype html>
<html>
  <title>Redirecting to: {redirectTo}</title>
  <meta http-equiv="refresh" content={'2;url=' + redirectTo} />
  <link rel="canonical" href={'http://0.0.0.0/' + redirectTo} />
</html>
<body>
  <a href={redirectTo}>
    Redirecting from <code>/admin/index.html</code> to <code>{redirectTo}</code>
  </a>
</body>
