---
import BaseLink from '@/components/preact/BaseLink';
import CartSidebar from '@/components/preact/CartSidebar';
import { APP_NAME, APP_VIP_CODE, resolveUrlFrom } from '@/utils/helpers';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import Layout from '@/layouts/_Layout.astro';
import ProductCard from '@/components/preact/ProductCard';
import ProductCatalog from '@/components/preact/ProductCatalog';
import type { IProduct, ICategory } from '@catalog/shared';
import IconBack from '~icons/mdi/arrow-left';

interface Props {
  category: ICategory;
  products: IProduct[];
}

const pn = Astro.url.pathname;
const { category, products } = Astro.props;
---

<Layout title={`${category.label || 'Categoría'} — ${APP_NAME}`}>
  <Header activeCategory={category.key} />
  <CartSidebar />

  <main class="max-w-7xl mx-auto px-4 py-6">
    <div class="mb-6">
      <BaseLink
        href={resolveUrlFrom(pn, '/')}
        class="text-sm text-gray-400 hover:text-primary-500 transition-colors inline-flex items-center gap-1 mb-3"
      >
        <IconBack class="size-4" />
        <span> Volver a todo </span>
      </BaseLink>
      <h1
        class="font-display font-bold text-2xl sm:text-3xl text-gray-800 flex items-center gap-3"
      >
        <span class="text-3xl">{category.emoji}</span>
        {category.label || 'Categoría no encontrada'}
      </h1>
      <p class="text-gray-500 mt-1">
        {products.length} producto{products.length !== 1 ? 's' : ''} en esta categoría
      </p>
    </div>

    {
      products.length > 0 ? (
        <ProductCatalog products={products} currentPath={pn} client:load />
      ) : (
        <div class="text-center py-16">
          <span class="text-6xl block mb-4">📭</span>
          <p class="text-gray-500 font-medium mb-1">
            No hay productos en esta categoría
          </p>
          <p class="text-sm text-gray-400 mb-4">
            Prueba explorando otras categorías
          </p>
          <BaseLink
            href={resolveUrlFrom(pn, '/')}
            class="btn-primary inline-block"
          >
            Ver todos los productos
          </BaseLink>
        </div>
      )
    }
  </main>

  <Footer />
</Layout>
