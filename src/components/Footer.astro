---
const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-100 mt-auto">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-2xl">🛍️</span>
          <span class="font-display font-bold text-lg text-gray-800"
            >WA-Catalog</span
          >
        </div>
        <p class="text-sm text-gray-500 leading-relaxed">
          Encuentra de todo con la mejor atención y precios accesibles.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-3">Navegación</h3>
        <ul class="space-y-2 text-sm text-gray-500">
          <li>
            <a href="/" class="hover:text-primary-500 transition-colors"
              >Inicio</a
            >
          </li>
          <li>
            <a
              href="/categoria/accesorios"
              class="hover:text-primary-500 transition-colors">Accesorios</a
            >
          </li>
          <li>
            <a
              href="/categoria/hogar"
              class="hover:text-primary-500 transition-colors">Hogar</a
            >
          </li>
          <li>
            <a
              href="/categoria/tecnologia"
              class="hover:text-primary-500 transition-colors">Tecnología</a
            >
          </li>
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-3">Categorías</h3>
        <ul class="space-y-2 text-sm text-gray-500">
          <li>
            <a
              href="/categoria/moda"
              class="hover:text-primary-500 transition-colors">Moda</a
            >
          </li>
          <li>
            <a
              href="/categoria/belleza"
              class="hover:text-primary-500 transition-colors">Belleza</a
            >
          </li>
          <li>
            <a
              href="/categoria/joyeria"
              class="hover:text-primary-500 transition-colors">Joyería</a
            >
          </li>
          <li>
            <a
              href="/categoria/audio"
              class="hover:text-primary-500 transition-colors">Audio</a
            >
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-3">Contacto</h3>
        <ul class="space-y-2 text-sm text-gray-500">
          <li class="flex items-center gap-2">
            <span>📱</span>
            <a
              href="https://wa.me/5363264783"
              class="hover:text-primary-500 transition-colors">WhatsApp</a
            >
          </li>
          <li class="flex items-center gap-2">
            <span>📍</span>
            <span>La Habana, Cuba</span>
          </li>
          <li class="flex items-center gap-2">
            <span>🕐</span>
            <span>Lun-Sáb: 9am - 6pm</span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-8 pt-6 border-t border-gray-100 text-center text-sm text-gray-400"
    >
      <p>&copy; {year} WA-Catalog. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
