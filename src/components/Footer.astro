---
import { APP_DESC, APP_NAME, WHATSAPP_NUMBER } from '@/utils/helpers';
import BaseLink from './preact/BaseLink';

const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-100 mt-auto">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-2xl">🛍️</span>
          <span class="font-display font-bold text-lg text-gray-800"
            >{APP_NAME}</span
          >
        </div>
        <p class="text-sm text-gray-500 leading-relaxed">
          {APP_DESC}
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-3">Navegación</h3>
        <ul class="space-y-2 text-sm text-gray-500">
          <li>
            <BaseLink href="/" class="hover:text-primary-500 transition-colors"
              >Inicio</BaseLink
            >
          </li>
          <li>
            <BaseLink
              href="/categories/accesorios"
              class="hover:text-primary-500 transition-colors"
              >Accesorios</BaseLink
            >
          </li>
          <li>
            <BaseLink
              href="/categories/hogar"
              class="hover:text-primary-500 transition-colors">Hogar</BaseLink
            >
          </li>
          <li>
            <BaseLink
              href="/categories/tecnologia"
              class="hover:text-primary-500 transition-colors"
              >Tecnología</BaseLink
            >
          </li>
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-3">Categorías</h3>
        <ul class="space-y-2 text-sm text-gray-500">
          <li>
            <BaseLink
              href="/categories/moda"
              class="hover:text-primary-500 transition-colors">Moda</BaseLink
            >
          </li>
          <li>
            <BaseLink
              href="/categories/belleza"
              class="hover:text-primary-500 transition-colors">Belleza</BaseLink
            >
          </li>
          <li>
            <BaseLink
              href="/categories/joyeria"
              class="hover:text-primary-500 transition-colors">Joyería</BaseLink
            >
          </li>
          <li>
            <BaseLink
              href="/categories/audio"
              class="hover:text-primary-500 transition-colors">Audio</BaseLink
            >
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-3">Contacto</h3>
        <ul class="space-y-2 text-sm text-gray-500">
          <li class="flex items-center gap-2">
            <span>📱</span>
            <BaseLink
              href={'https://wa.me/' + WHATSAPP_NUMBER}
              class="hover:text-primary-500 transition-colors"
              >WhatsApp</BaseLink
            >
          </li>
          <li class="flex items-center gap-2">
            <span>📍</span>
            <span>La Habana, Cuba</span>
          </li>
          <li class="flex items-center gap-2">
            <span>🕐</span>
            <span>Lun-Sáb: 9am - 6pm</span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-8 pt-6 border-t border-gray-100 text-center text-sm text-gray-400"
    >
      <p>&copy; {year} {APP_NAME}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
