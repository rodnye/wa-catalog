---
import {
  APP_DESC,
  APP_NAME,
  resolveUrlFrom,
  WHATSAPP_NUMBER,
} from '@/utils/helpers';
import BaseLink from './preact/BaseLink';
import { getCategories } from '@/lib/categories';
import { loadAllProducts } from '@/lib/products';
import IconWhatsapp from '~icons/mdi/whatsapp';
import IconMapMarker from '~icons/mdi/map-marker';
import IconClockOutline from '~icons/mdi/clock-outline';

const pn = Astro.url.pathname;
const year = new Date().getFullYear();
const products = await loadAllProducts();
const primaryCategories = getCategories()
  .map(({ key, slug, label }) => ({
    slug,
    label,
    count: products.filter((p) => p.categories.includes(key)).length,
  }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 7);
---

<footer class="bg-white border-t border-gray-100 mt-auto">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-2xl">🛍️</span>
          <span class="font-display font-bold text-lg text-gray-800">
            {APP_NAME}
          </span>
        </div>
        <p class="text-sm text-gray-500 leading-relaxed">
          {APP_DESC}
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-semibold text-gray-800 mb-3">Navegación</h3>
        <ul class="space-y-2 text-sm text-gray-500">
          <li>
            <BaseLink
              href={resolveUrlFrom(pn, '/')}
              class="hover:text-primary-500 transition-colors"
            >
              Inicio
            </BaseLink>
          </li>
          {
            primaryCategories.slice(0, 3).map(({ label, slug }) => (
              <li>
                <BaseLink
                  href={resolveUrlFrom(pn, '/categories/' + slug)}
                  class="hover:text-primary-500 transition-colors"
                >
                  {label}
                </BaseLink>
              </li>
            ))
          }
        </ul>

        <!-- Categories -->
        <div class="mt-3">
          <h3 class="font-semibold text-gray-800 mb-3">Categorías</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            {
              primaryCategories.slice(3, 7).map(({ label, slug }) => (
                <li>
                  <BaseLink
                    href={resolveUrlFrom(pn, '/categories/' + slug)}
                    class="hover:text-primary-500 transition-colors"
                  >
                    {label}
                  </BaseLink>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Contact -->
        <div class="mt-3">
          <h3 class="font-semibold text-gray-800 mb-3">Contacto</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            <li class="flex items-center gap-2">
              <IconWhatsapp class="text-lg text-green-600" />
              <BaseLink
                href={'https://wa.me/' + WHATSAPP_NUMBER}
                class="hover:text-primary-500 transition-colors"
              >
                WhatsApp
              </BaseLink>
            </li>
            <li class="flex items-center gap-2">
              <IconMapMarker class="text-lg text-red-400" />
              <span>La Habana, Cuba</span>
            </li>
            <li class="flex items-center gap-2">
              <IconClockOutline class="text-lg text-blue-700" />
              <span>Lun-Sáb: 9am - 6pm</span>
            </li>
          </ul>
        </div>
      </div>

      <div
        class="mt-8 pt-6 border-t border-gray-100 text-center text-sm text-gray-400"
      >
        <p>&copy; {year} {APP_NAME}. Todos los derechos reservados.</p>
      </div>
    </div>
  </div>
</footer>
