---
import BaseLink from './preact/BaseLink';
import CartToggle from '@/components/preact/CartToggle';
import MobileSearchToggle from '@/components/preact/MobileSearchToggle';
import SearchBar from '@/components/preact/SearchBar';
import MobileMenuToggle from '@/components/preact/MobileMenuToggle';
import MobileMenuPanel from '@/components/preact/MobileMenuPanel';
import { getCategories } from '@/lib/categories';
import { APP_NAME, resolveUrlFrom } from '@/utils/helpers';

interface Props {
  activeCategory?: string;
}

const pn = Astro.url.pathname;
const { activeCategory = '' } = Astro.props;
const categories = getCategories();
---

<header
  class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100 shadow-sm"
>
  <div class="max-w-7xl mx-auto px-4">
    <!-- Top bar: Logo + Search + Cart -->
    <div class="flex items-center justify-between h-16 gap-3">
      <!-- Logo -->
      <BaseLink
        href={resolveUrlFrom(pn, '/')}
        class="flex items-center gap-2 shrink-0"
      >
        <span class="text-2xl">🛍️</span>
        <span
          class="font-display font-bold text-xl text-gray-800 hidden sm:block"
        >
          {APP_NAME}
        </span>
      </BaseLink>

      <!-- Search bar (desktop) -->
      <div class="hidden md:flex flex-1 max-w-lg mx-4">
        <SearchBar client:load />
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <!-- Search toggle (mobile) + collapsible input -->
        <MobileSearchToggle client:load />

        <!-- Cart button -->
        <CartToggle client:load />
      </div>
    </div>

    <!-- Categories nav (desktop) -->
    <nav
      class="hidden lg:flex gap-2 overflow-x-auto hide-scrollbar py-3 -mx-4 px-4 border-t border-gray-50"
    >
      <BaseLink
        href={resolveUrlFrom(pn, '/')}
        class:list={[
          'shrink-0 px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200',
          activeCategory === ''
            ? 'bg-primary-500 text-white shadow-sm'
            : 'bg-gray-100 text-gray-600 hover:bg-primary-50 hover:text-primary-600',
        ]}
      >
        Todo
      </BaseLink>
      {
        categories.map((cat) => (
          <BaseLink
            href={resolveUrlFrom(pn, `/categories/${cat.slug}`)}
            class:list={[
              'shrink-0 px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200',
              activeCategory === cat.key
                ? 'bg-primary-500 text-white shadow-sm'
                : 'bg-gray-100 text-gray-600 hover:bg-primary-50 hover:text-primary-600',
            ]}
          >
            {cat.emoji} {cat.label}
          </BaseLink>
        ))
      }
    </nav>

    <!-- Mobile categories nav with hamburger menu -->
    <div class="flex items-center gap-2 py-3 border-t border-gray-50 lg:hidden">
      <MobileMenuToggle client:load />
      <div class="flex-1 overflow-x-auto hide-scrollbar">
        <div class="flex gap-2">
          <BaseLink
            href={resolveUrlFrom(pn, '/')}
            class:list={[
              'shrink-0 px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200',
              activeCategory === ''
                ? 'bg-primary-500 text-white shadow-sm'
                : 'bg-gray-100 text-gray-600 hover:bg-primary-50 hover:text-primary-600',
            ]}
          >
            Todo
          </BaseLink>
          {
            categories.slice(0, 5).map((cat) => (
              <BaseLink
                href={resolveUrlFrom(pn, `/categories/${cat.slug}`)}
                class:list={[
                  'shrink-0 px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200',
                  activeCategory === cat.key
                    ? 'bg-primary-500 text-white shadow-sm'
                    : 'bg-gray-100 text-gray-600 hover:bg-primary-50 hover:text-primary-600',
                ]}
              >
                {cat.emoji} {cat.label}
              </BaseLink>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu Panel -->
<MobileMenuPanel activeCategory={activeCategory} client:load />
