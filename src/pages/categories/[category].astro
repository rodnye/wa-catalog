---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import CartSidebar from '../../components/CartSidebar.astro';
import { loadAllProducts, getCategories } from '../../lib/products';

export async function getStaticPaths() {
  const allProducts = await loadAllProducts();
  const categories = getCategories(allProducts);

  return categories.map((cat) => ({
    params: { category: cat.toLowerCase().replace(/\s+/g, '-') },
    props: { category: cat, allProducts },
  }));
}

const { category: matchedCategory, allProducts } = Astro.props;
const allProductsFresh = await loadAllProducts();
const categories = getCategories(allProductsFresh);

const categorySlug = Astro.params.category || '';
const filtered = matchedCategory
  ? allProductsFresh.filter((p) =>
      p.categories.some(
        (c) => c.toLowerCase().replace(/\s+/g, '-') === categorySlug,
      ),
    )
  : [];

const categoryEmojis: Record<string, string> = {
  Accesorios: '💎',
  Joyería: '💍',
  Artesanía: '🎨',
  Moda: '👗',
  Hogar: '🏠',
  Bienestar: '🌿',
  Jardinería: '🌱',
  Tecnología: '📱',
  Audio: '🎧',
  Outdoor: '🏕️',
  Ropa: '👕',
  Belleza: '✨',
  Maquillaje: '💄',
};
const emoji = matchedCategory ? categoryEmojis[matchedCategory] || '📦' : '📦';
---

<Layout title={`${matchedCategory || 'Categoría'} — WA-Catalog`}>
  <Header categories={categories} activeCategory={matchedCategory} />
  <CartSidebar />

  <main class="max-w-7xl mx-auto px-4 py-6">
    <div class="mb-6">
      <a
        href="/"
        class="text-sm text-gray-400 hover:text-primary-500 transition-colors inline-flex items-center gap-1 mb-3"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path></svg
        >
        Volver a todo
      </a>
      <h1
        class="font-display font-bold text-2xl sm:text-3xl text-gray-800 flex items-center gap-3"
      >
        <span class="text-3xl">{emoji}</span>
        {matchedCategory || 'Categoría no encontrada'}
      </h1>
      <p class="text-gray-500 mt-1">
        {filtered.length} producto{filtered.length !== 1 ? 's' : ''} en esta categoría
      </p>
    </div>

    {
      filtered.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
          {filtered.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <span class="text-6xl block mb-4">📭</span>
          <p class="text-gray-500 font-medium mb-1">
            No hay productos en esta categoría
          </p>
          <p class="text-sm text-gray-400 mb-4">
            Prueba explorando otras categorías
          </p>
          <a href="/" class="btn-primary inline-block">
            Ver todos los productos
          </a>
        </div>
      )
    }
  </main>

  <Footer />
</Layout>
