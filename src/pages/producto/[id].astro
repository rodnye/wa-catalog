---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import CartSidebar from '../../components/CartSidebar.astro';
import { loadAllProducts, getCategories } from '../../lib/products';
import { formatPrice } from '../../utils/helpers';

export async function getStaticPaths() {
  const allProducts = await loadAllProducts();

  return allProducts.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const allProducts = await loadAllProducts();
const categories = getCategories(allProducts);

const related = allProducts
  .filter(
    (p) =>
      p.id !== product.id &&
      p.categorias.some((c) => product.categorias.includes(c)),
  )
  .slice(0, 4);

const categoryEmojis: Record<string, string> = {
  Accesorios: '💎',
  Joyería: '💍',
  Artesanía: '🎨',
  Moda: '👗',
  Hogar: '🏠',
  Bienestar: '🌿',
  Jardinería: '🌱',
  Tecnología: '📱',
  Audio: '🎧',
  Outdoor: '🏕️',
  Ropa: '👕',
  Belleza: '✨',
  Maquillaje: '💄',
};
---

<Layout title={`${product.nombre} — WA-Catalog`}>
  <Header categories={categories} />
  <CartSidebar />

  <main class="max-w-7xl mx-auto px-4 py-6">
    <nav class="mb-5">
      <a
        href="/"
        class="text-sm text-gray-400 hover:text-primary-500 transition-colors inline-flex items-center gap-1"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path></svg
        >
        Volver
      </a>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-10">
      <!-- Images -->
      <div class="space-y-3">
        <div class="rounded-2xl overflow-hidden bg-gray-50 aspect-square">
          <img
            id="main-image"
            src={product.imagenes[0] || '/images/placeholder.jpg'}
            alt={product.nombre}
            class="w-full h-full object-cover"
            onerror="this.src='/images/placeholder.jpg'"
          />
        </div>
        {
          product.imagenes.length > 1 && (
            <div class="flex gap-2 overflow-x-auto hide-scrollbar">
              {product.imagenes.map((img, i) => (
                <button
                  class="thumbnail-btn w-16 h-16 rounded-xl overflow-hidden border-2 flex-shrink-0 transition-all"
                  class:list={[
                    i === 0
                      ? 'border-primary-500'
                      : 'border-gray-200 hover:border-primary-300',
                  ]}
                  data-src={img}
                >
                  <img
                    src={img}
                    alt={`${product.nombre} - ${i + 1}`}
                    class="w-full h-full object-cover"
                    onerror="this.src='/images/placeholder.jpg'"
                  />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <!-- Info -->
      <div class="flex flex-col">
        <div class="flex flex-wrap gap-2 mb-3">
          {
            product.categorias.map((cat) => (
              <a
                href={`/categoria/${cat.toLowerCase().replace(/\s+/g, '-')}`}
                class="badge hover:bg-primary-200 transition-colors cursor-pointer"
              >
                {categoryEmojis[cat] || ''} {cat}
              </a>
            ))
          }
        </div>

        <h1
          class="font-display font-bold text-2xl sm:text-3xl text-gray-800 mb-2"
        >
          {product.nombre}
        </h1>

        <div class="flex items-center gap-3 mb-4">
          <span class="font-display font-extrabold text-3xl text-primary-600"
            >{formatPrice(product.precio)}</span
          >
          {
            product.destacado && (
              <span class="bg-accent-100 text-accent-700 text-xs font-bold px-2.5 py-1 rounded-full">
                ⭐ Destacado
              </span>
            )
          }
        </div>

        <p class="text-gray-600 leading-relaxed mb-6">{product.descripcion}</p>

        <div class="mt-auto space-y-3">
          {
            product.disponible ? (
              <button
                class="add-to-cart-btn w-full btn-accent text-base py-3.5 flex items-center justify-center gap-2"
                data-product-id={product.id}
                data-product-name={product.nombre}
                data-product-price={product.precio}
                data-product-image={product.imagenes[0] || ''}
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"
                  />
                </svg>
                Agregar al Carrito
              </button>
            ) : (
              <button
                class="w-full bg-gray-200 text-gray-500 font-semibold py-3.5 rounded-xl cursor-not-allowed"
                disabled
              >
                Producto Agotado
              </button>
            )
          }

          <a
            href={`https://wa.me/5351234567?text=${encodeURIComponent(`Hola, me interesa el producto: ${product.nombre} (${formatPrice(product.precio)})`)}`}
            target="_blank"
            class="w-full bg-green-50 hover:bg-green-100 text-green-700 font-semibold py-3 rounded-xl transition-colors flex items-center justify-center gap-2 border border-green-200"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
            Preguntar por WhatsApp
          </a>
        </div>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display font-bold text-xl sm:text-2xl text-gray-800 mb-5">
            También te puede interesar
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </section>
      )
    }
  </main>

  <Footer />

  <script>
    document.querySelectorAll('.thumbnail-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mainImage = document.getElementById('main-image');
        const src = btn.dataset.src;
        if (mainImage && src) {
          mainImage.src = src;
          document.querySelectorAll('.thumbnail-btn').forEach((b) => {
            b.classList.remove('border-primary-500');
            b.classList.add('border-gray-200');
          });
          btn.classList.remove('border-gray-200');
          btn.classList.add('border-primary-500');
        }
      });
    });
  </script>
</Layout>
