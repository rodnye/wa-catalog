---
import { resolveUrl } from '@/utils/helpers';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'WA-Catalog — Encuentra de Todo',
  description = 'Tienda variada con los mejores productos al mejor precio. Accesorios, hogar, tecnología, moda y más.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={resolveUrl('/favicon.svg')} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
