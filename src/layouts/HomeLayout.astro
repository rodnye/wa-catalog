---
import Layout from '@/layouts/_Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { loadAllProducts } from '@/lib/products';
import BaseLink from '@/components/preact/BaseLink';
import {
  BANNER_CONTENT,
  BANNER_TITLE,
  isVipUrl,
  resolveUrlBase,
  resolveUrlFrom,
  WHATSAPP_LINK,
} from '@/utils/helpers';
import type { IProduct } from '@/types';
import IconShopBag from '~icons/mdi/shopping';
import IconStar from '~icons/mdi/star';
import ProductCard from '@/components/ProductCard.astro';
import logoImg from '@/assets/logo_only_icon.webp';

const pn = Astro.url.pathname;

// Dynamically load all products from src/data/*.json
const allProducts = await loadAllProducts({ withVIP: isVipUrl(pn) });

const linkParser = ({ id }: IProduct) => {
  return resolveUrlFrom(pn, `/products/${id}`);
};

// Featured products
const featured = allProducts.filter((p) => p.featured);
const nonFeatured = allProducts.filter((p) => !p.featured);
---

<Layout iconType="image/webp" iconHref={resolveUrlBase(logoImg.src)}>
  <Header />

  <main class="max-w-7xl mx-auto px-4 py-6">
    <!-- Hero -->
    <section class="mb-8">
      <div
        class="bg-gradient-to-br from-primary-400 via-primary-500 to-sand-500 rounded-3xl p-6 sm:p-10 text-white relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/4"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 w-48 h-48 bg-white/10 rounded-full translate-y-1/3 -translate-x-1/4"
        >
        </div>
        <div class="relative z-10">
          <h1
            class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl mb-3"
          >
            {BANNER_TITLE}
          </h1>
          <p class="text-white/80 text-base sm:text-lg max-w-lg mb-5">
            {BANNER_CONTENT}
          </p>
          <div class="flex gap-3">
            <BaseLink
              href="#products"
              class="bg-white text-primary-600 font-semibold py-2.5 px-6 rounded-xl hover:bg-gray-50 transition-all shadow-sm"
            >
              Ver Productos
            </BaseLink>
            <BaseLink
              href={WHATSAPP_LINK}
              target="_blank"
              class="bg-white/20 text-white font-semibold py-2.5 px-6 rounded-xl hover:bg-white/30 transition-all border border-white/30"
            >
              Contáctanos
            </BaseLink>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Products -->
    {
      featured.length > 0 && (
        <section class="mb-10">
          <div class="flex items-center justify-between mb-5">
            <h2 class="flex items-center font-display font-bold text-xl sm:text-2xl text-gray-800">
              <IconStar class="size-8 mr-2 text-yellow-400" />
              <span> Destacados </span>
            </h2>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
            {featured.map((p) => (
              <ProductCard product={p} link={linkParser(p)} />
            ))}
          </div>
        </section>
      )
    }

    <!-- All Products (with client-side search) -->
    <section id="products" class="mb-10">
      <div class="flex items-center justify-between mb-5">
        <h2
          class="font-display font-bold text-xl sm:text-2xl flex items-center text-gray-800"
        >
          <IconShopBag class="size-8 mr-2 text-purple-500" />
          <span> Todos los productos </span>
        </h2>
      </div>
      <div
        class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5"
      >
        {
          nonFeatured.map((p) => (
            <ProductCard product={p} link={linkParser(p)} />
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
