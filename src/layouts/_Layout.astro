---
import { APP_DESC, APP_NAME, resolveUrlBase } from '@/utils/helpers';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  iconHref?: string;
  iconType?: string;
}

const {
  title = APP_NAME,
  description = APP_DESC,
  iconHref = resolveUrlBase('/favicon.svg'),
  iconType = 'image/svg+xml',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type={iconType} href={iconHref} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
